# ===== LLM Provider (pick one or more) =====
# Option 1: OpenAI (default)
OPENAI_API_KEY=sk-...

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Option 3: 100% Free & Local via Ollama (zero API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# ===== Search Provider =====
# Option 1: DuckDuckGo (Free, default, zero setup)
DEFAULT_SEARCH_PROVIDER=duckduckgo

# Option 2: Tavily (Optimized for AI agents)
# TAVILY_API_KEY=tvly-...

# Option 3: SerpAPI
# SERPAPI_KEY=...

# ===== Agent Tuning & Thresholds =====
DEFAULT_LLM_PROVIDER=openai          # openai | anthropic | ollama
DEFAULT_LLM_MODEL=gpt-4o-mini        # gpt-4o | claude-3-5-sonnet-20241022 | llama3
MIN_RELEVANCE_SCORE=0.35             # Threshold to retain evidence (0.0 to 1.0)
MAX_PLAN_STEPS=8                     # Max steps planner can generate
MAX_CONCURRENT_TOOLS=4               # Max tools executed in parallel (asyncio.Semaphore)
REQUEST_TIMEOUT=60.0                 # Timeout in seconds

# ===== Safety & Security Defaults =====
HUMAN_GATE_ENABLED=false             # Interactive approval checkpoints ([P]roceed/[E]dit/[A]bort)
CODE_RUNNER_ENABLED=false            # Sandboxed code execution (false = disabled for security by default)

# ===== Persistence =====
SESSION_DB_PATH=~/.research_agent/sessions.db
